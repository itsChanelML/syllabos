# SyllabOS — Environment Variables
# Copy this file: cp .env.example .env
# Fill in your values. Never commit .env to GitHub.

# REQUIRED — get free at build.nvidia.com (no credit card needed)
NIM_API_KEY=your_nim_api_key_here

# OPTIONAL — personalizes your output
STUDENT_NAME=Your Full Name
STUDENT_EMAIL=your@email.com

# ─── Morning voice briefing (--morning / --listen) ──────────────────────────
# All OPTIONAL. See README "Morning voice briefing" for full setup.

# Your IANA timezone — used for "today", and to get deadline countdowns right.
# Defaults to your system timezone if unset (requires `pip3 install tzlocal`).
STUDENT_TIMEZONE=America/New_York

# Speech backend: "nvidia" (default) or "system" (fully offline, no API key,
# text-to-speech only — no spoken trigger, keyboard fallback still works).
# If "nvidia" isn't configured or unreachable, SyllabOS automatically falls
# back to "system" for speech OUTPUT with a visible warning — it never fails
# silently.
VOICE_PROVIDER=nvidia

# NVIDIA Riva speech (only used when VOICE_PROVIDER=nvidia) — reuses your
# NIM_API_KEY above. Function IDs are per-model and NVIDIA's catalog changes
# over time, so they are never hardcoded — get your own:
#   1. Go to https://build.nvidia.com/explore/speech
#   2. Open an ASR model (recommended: parakeet-tdt-0.6b-v2) -> "Try API" ->
#      "Python" tab -> copy its function-id
#   3. Do the same for a TTS model (recommended: magpie-tts-multilingual)
NVIDIA_ASR_FUNCTION_ID=
NVIDIA_TTS_FUNCTION_ID=
NVIDIA_ASR_LANGUAGE=en-US
NVIDIA_TTS_LANGUAGE=en-US
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Female-1
NVIDIA_TTS_SAMPLE_RATE=44100

# Live Google Calendar (read-only) — falls back to your last CSV export
# (with a clear staleness warning) if not set up. See README for the
# Google Cloud Console walkthrough. Run: python3 syllabos.py --calendar-auth
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json